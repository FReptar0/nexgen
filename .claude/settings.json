{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm install:*)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run:*)",
      "Bash(npm ls:*)",
      "Bash(npm outdated)",
      "Bash(npm audit)",
      "Bash(node:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git worktree:*)",
      "Bash(gh:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(jq:*)",
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:syn-magento.azurewebsites.net)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Read(./logs/**)",
      "Read(./results/**)",
      "Read(./test-files/**)",
      "Bash(rm:-rf:*)",
      "Bash(git push:* --force:*)",
      "Bash(git push:* -f)",
      "Bash(git reset:--hard:*)",
      "Bash(git clean:-f:*)",
      "Bash(curl:* --data:*)",
      "Bash(curl:* -d:*)",
      "Bash(curl:* --data-binary:*)"
    ]
  }
}
